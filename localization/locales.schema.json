{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rstorrent.invalid/localization/locales.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceLocale",
    "fallbackLocale",
    "supportedLocales",
    "testLocales",
    "previewLocales",
    "catalogs"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "sourceLocale": { "type": "string", "const": "en" },
    "fallbackLocale": { "type": "string", "const": "en" },
    "supportedLocales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "desktop", "android", "ios"],
      "properties": {
        "web": { "$ref": "#/$defs/localeList" },
        "desktop": { "$ref": "#/$defs/localeList" },
        "android": { "$ref": "#/$defs/localeList" },
        "ios": { "$ref": "#/$defs/localeList" }
      }
    },
    "previewLocales": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "android": { "$ref": "#/$defs/localeList" }
      }
    },
    "testLocales": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "direction", "purpose"],
        "properties": {
          "tag": { "enum": ["en-XA", "ar-XB"] },
          "direction": { "enum": ["ltr", "rtl"] },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "android", "ios"],
      "properties": {
        "web": { "type": "string", "minLength": 1 },
        "android": { "type": "string", "minLength": 1 },
        "ios": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "localeList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" }
    }
  }
}
