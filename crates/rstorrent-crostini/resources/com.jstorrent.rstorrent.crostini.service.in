[Unit]
Description=JSTorrent for ChromeOS Linux
Documentation=https://github.com/kzahel/jstorrent

[Service]
Type=simple
ExecStart=@RSTORRENT_CROSTINI_BINARY@ serve
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
PrivateTmp=true

# Deliberately no enablement section. The ChromeOS Launcher starts this static
# user unit on demand; installation never enables it or changes user lingering.
