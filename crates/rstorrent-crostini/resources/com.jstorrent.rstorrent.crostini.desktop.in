[Desktop Entry]
Type=Application
Version=1.0
Name=JSTorrent for ChromeOS Linux
GenericName=BitTorrent Client
Comment=Open JSTorrent using ChromeOS Linux
Exec=@RSTORRENT_CROSTINI_BINARY@ launch
Icon=com.jstorrent.rstorrent.crostini
Terminal=false
Categories=Network;FileTransfer;
Keywords=torrent;BitTorrent;download;magnet;
StartupNotify=true
StartupWMClass=com.jstorrent.rstorrent.crostini
