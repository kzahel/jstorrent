---
import BaseLayout from './BaseLayout.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description: string
  date: Date
  tags?: string[]
}

const { title, description, date, tags } = Astro.props
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const isoDate = date.toISOString().split('T')[0]
---

<BaseLayout
  title={`${title} — JSTorrent`}
  description={description}
  ogType="article"
  publishedTime={isoDate}
>
  <Header />
  <main class="blog-post">
    <div class="blog-post-container">
      <article>
        <header class="blog-post-header">
          <h1>{title}</h1>
          <div class="blog-post-meta">
            <time datetime={isoDate}>{formattedDate}</time>
            {tags && tags.length > 0 && (
              <div class="blog-post-tags">
                {tags.map((tag) => (
                  <span class="blog-tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
          <a href="/blog/" class="blog-back-link">&larr; Back to Blog</a>
        </header>
        <div class="blog-post-content">
          <slot />
        </div>
      </article>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog-post {
    padding: 2rem 0;
  }

  .blog-post-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .blog-post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .blog-post-header h1 {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .blog-post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    color: var(--color-text-light);
    font-size: 0.9rem;
    margin-bottom: 0.75rem;
  }

  .blog-post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .blog-tag {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.8rem;
    color: var(--color-text-light);
  }

  .blog-back-link {
    font-size: 0.9rem;
  }

  .blog-post-content {
    line-height: 1.75;
    font-size: 1.05rem;
  }

  .blog-post-content :global(h2) {
    font-size: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .blog-post-content :global(h3) {
    font-size: 1.2rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .blog-post-content :global(p) {
    margin-bottom: 1rem;
  }

  .blog-post-content :global(ul),
  .blog-post-content :global(ol) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    list-style: disc;
  }

  .blog-post-content :global(ol) {
    list-style: decimal;
  }

  .blog-post-content :global(li) {
    margin-bottom: 0.25rem;
  }

  .blog-post-content :global(code) {
    background: var(--color-code-bg);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
  }

  .blog-post-content :global(pre) {
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .blog-post-content :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  .blog-post-content :global(blockquote) {
    border-left: 3px solid var(--color-primary);
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    color: var(--color-text-light);
    font-style: italic;
  }

  .blog-post-content :global(a) {
    color: var(--color-link);
  }

  .blog-post-content :global(a:hover) {
    text-decoration: underline;
  }

  @media (min-width: 640px) {
    .blog-post-header h1 {
      font-size: 2.25rem;
    }

    .blog-post-container {
      padding: 0 1.5rem;
    }
  }
</style>
