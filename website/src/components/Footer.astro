    <h2>Links</h2>
    <div class="links-grid">
      <div class="links-group">
        <h3>Resources</h3>
        <ul>
          <li>
            <a href="https://chromewebstore.google.com/detail/jstorrent/dbokmlpefliilbjldladbimlcfgbolhk">
              Chrome Web Store
            </a>
          </li>
          <li>
            <a href="https://play.google.com/store/apps/details?id=com.jstorrent.app">
              Google Play Store
            </a>
          </li>
          <li>
            <a href="/privacy.html">Privacy Policy</a>
          </li>
        </ul>
      </div>
      <div class="links-group">
        <h3>Development</h3>
        <ul>
          <li>
            <a href={sourceRepositoryUrl}>Source Code</a>
          </li>
          <li>
            <a href={`${sourceRepositoryUrl}/issues`}>Issue Tracker</a>
          </li>
          <li>
            <a href="/blog/">Dev Blog</a>
          </li>
