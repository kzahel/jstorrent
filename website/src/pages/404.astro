---
import '../styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="icon" type="image/png" href="/jstorrent.png" />
    <meta name="robots" content="noindex" />
    <title>Not found — JSTorrent</title>
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="title">
        <img class="brand-mark" src="/jstorrent.png" width="256" height="256" alt="" />

        <div class="copy">
          <p class="status"><span></span> 404</p>
          <h1 id="title">Not found</h1>
          <p class="lead">That JSTorrent page does not exist.</p>
          <a class="github-link" href="/">Return home</a>
        </div>
      </section>
    </main>
