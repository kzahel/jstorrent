---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="JSTorrent — Get the app" description="The browser prototype has retired. Download the current JSTorrent app.">
  <Header />
  <main class="section"><div class="container">
    <h1>Get the JSTorrent app</h1>
    <p>This browser prototype has retired. Use the current desktop or Android app to download torrents.</p>
    <a class="btn btn-primary" href="/#download">Download JSTorrent</a>
  </div></main>
  <Footer />
</BaseLayout>
