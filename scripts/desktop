#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
web_root="$repository_root/clients/web"
installed_lock="$web_root/node_modules/.package-lock.json"
source "$repository_root/scripts/dev-env.sh"
# The native shell and embedded React assets must advertise the same locales.
export VITE_RSTORRENT_ENABLE_PREVIEW_LOCALES=1

unset npm_config_recursive NPM_CONFIG_RECURSIVE

node "$repository_root/scripts/prepare-native-host.mjs"

if [[ ! -x "$web_root/node_modules/.bin/vite" ||
    ! -f "$installed_lock" ||
    "$web_root/package-lock.json" -nt "$installed_lock" ]]; then
    echo "Installing locked desktop web dependencies..." >&2
    (
        cd "$web_root"
        npm ci --no-audit --no-fund
    )
fi

(
    cd "$web_root"
    npm run build
)

cd "$repository_root"
exec cargo run -p rstorrent-desktop
