#!/usr/bin/env bash
set -euo pipefail

repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
web_root="$repository_root/clients/web"
installed_lock="$web_root/node_modules/.package-lock.json"
data_root="${RSTORRENT_WEBUI_DATA_ROOT:-$repository_root/.local/webui}"
web_port="${RSTORRENT_WEBUI_PORT:-4177}"
open_browser=1
reload=0

usage() {
    printf '%s\n' \
        "Usage: ./scripts/webui [--reload] [--no-open]" \
        "" \
        "Run the live React inspection UI in a normal browser." \
        "State defaults to .local/webui and survives launcher restarts." \
        "No download folder is assumed; choose one when adding a torrent." \
        "" \
        "Options:" \
        "  --reload   Serve UI source with Vite hot reload." \
        "  --no-open  Start the server without opening a browser tab." \
        "  --help     Show this help."
}

while (($# > 0)); do
    case "$1" in
        --no-open)
            open_browser=0
            ;;
        --reload)
            reload=1
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            printf 'Unknown argument: %s\n\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

case "$web_port" in
    ''|*[!0-9]*)
        printf 'RSTORRENT_WEBUI_PORT must be a numeric TCP port.\n' >&2
        exit 2
        ;;
esac
if ((web_port < 1024 || web_port > 65535)); then
    printf 'RSTORRENT_WEBUI_PORT must be within 1024..65535.\n' >&2
    exit 2
fi

unset npm_config_recursive NPM_CONFIG_RECURSIVE

for required_command in cargo npm curl mktemp; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
        printf 'Required command is unavailable: %s\n' "$required_command" >&2
        exit 1
    fi
done

gateway_pid=""
vite_pid=""
launcher_started=0
runtime_root="$(mktemp -d "${TMPDIR:-/tmp}/rstorrent-webui.XXXXXX")"
gateway_log="$runtime_root/gateway.log"
vite_log="$runtime_root/vite.log"

stop_process() {
    local process_id="$1"
    local initial_signal="$2"
    local label="$3"
    local attempt

    [[ -n "$process_id" ]] || return 0
    if kill -0 "$process_id" 2>/dev/null; then
        kill -s "$initial_signal" "$process_id" 2>/dev/null || true
        for ((attempt = 0; attempt < 100; attempt++)); do
            kill -0 "$process_id" 2>/dev/null || break
            sleep 0.05
        done
    fi
    if kill -0 "$process_id" 2>/dev/null; then
        printf '%s did not stop promptly; sending TERM.\n' "$label" >&2
        kill -TERM "$process_id" 2>/dev/null || true
        for ((attempt = 0; attempt < 40; attempt++)); do
            kill -0 "$process_id" 2>/dev/null || break
            sleep 0.05
        done
    fi
    if kill -0 "$process_id" 2>/dev/null; then
        printf '%s did not join after TERM; sending KILL.\n' "$label" >&2
        kill -KILL "$process_id" 2>/dev/null || true
    fi
    wait "$process_id" 2>/dev/null || true
}

cleanup() {
    local status=$?
    trap - EXIT INT TERM
    stop_process "$vite_pid" INT "Vite development server"
    stop_process "$gateway_pid" INT "application gateway"
    rm -f -- "$gateway_log" "$vite_log"
    rmdir -- "$runtime_root" 2>/dev/null || true
    if ((launcher_started == 1)); then
        printf 'RSTorrent web UI stopped.\n'
    fi
    exit "$status"
}

trap 'exit 130' INT
trap 'exit 143' TERM
trap cleanup EXIT

mkdir -p -- "$data_root/profile"

if [[ ! -x "$web_root/node_modules/.bin/vite" ||
    ! -f "$installed_lock" ||
    "$web_root/package-lock.json" -nt "$installed_lock" ]]; then
    printf 'Installing locked web UI dependencies...\n' >&2
    (
        cd "$web_root"
        npm ci --no-audit --no-fund
    )
fi

if ((reload == 1)); then
    printf 'Preparing hot-reload web UI...\n' >&2
    (
        cd "$web_root"
        npm run predev
    )
    gateway_bind="127.0.0.1:0"
    web_assets_root="$web_root"
else
    printf 'Building production web UI...\n' >&2
    (
        cd "$web_root"
        VITE_RSTORRENT_DEFAULT_LIVE=same-origin npm run build:hosted
    )
    gateway_bind="127.0.0.1:$web_port"
    web_assets_root="$web_root/dist"
fi

printf 'Building application gateway...\n' >&2
(
    cd "$repository_root"
    cargo build -p rstorrent-gateway --bin rstorrent-gateway
)

target_root="${CARGO_TARGET_DIR:-$repository_root/target}"
if [[ "$target_root" != /* ]]; then
    target_root="$repository_root/$target_root"
fi
gateway_binary="$target_root/debug/rstorrent-gateway"
if [[ ! -x "$gateway_binary" ]]; then
    printf 'Gateway executable was not produced at %s.\n' "$gateway_binary" >&2
    exit 1
fi

origin="http://127.0.0.1:$web_port"
(
    export RSTORRENT_PROFILE_ROOT="$data_root/profile"
    export RSTORRENT_GATEWAY_AUTH="unauthenticated_loopback_development"
    export RSTORRENT_GATEWAY_BIND="$gateway_bind"
    export RSTORRENT_GATEWAY_ORIGIN="$origin"
    export RSTORRENT_WEB_ROOT="$web_assets_root"
    export RSTORRENT_BUILD_ID="local-webui"
    export RSTORRENT_NETWORK_POLICY="${RSTORRENT_NETWORK_POLICY:-online}"
    unset RSTORRENT_GATEWAY_TOKEN
    exec "$gateway_binary"
) >"$gateway_log" 2>&1 &
gateway_pid=$!

gateway_address=""
for ((attempt = 0; attempt < 200; attempt++)); do
    if ! kill -0 "$gateway_pid" 2>/dev/null; then
        printf 'Application gateway exited during startup.\n' >&2
        sed -n '1,120p' "$gateway_log" >&2
        exit 1
    fi
    gateway_address="$(sed -n 's/^gateway listening on //p' "$gateway_log" | tail -n 1)"
    [[ -n "$gateway_address" ]] && break
    sleep 0.05
done
if [[ -z "$gateway_address" ]]; then
    printf 'Timed out waiting for the application gateway.\n' >&2
    sed -n '1,120p' "$gateway_log" >&2
    exit 1
fi
if [[ "$gateway_address" != 127.0.0.1:* ]] ||
    { ((reload == 0)) && [[ "$gateway_address" != "$gateway_bind" ]]; }; then
    printf 'Application gateway bound an unexpected address: %s.\n' \
        "$gateway_address" >&2
    exit 1
fi

if ((reload == 1)); then
    (
        cd "$web_root"
        export VITE_RSTORRENT_DEFAULT_LIVE=same-origin
        export RSTORRENT_WEBUI_PROXY_TARGET="http://$gateway_address"
        export RSTORRENT_WEBUI_RELOAD=1
        exec "$web_root/node_modules/.bin/vite" \
            --host 127.0.0.1 --port "$web_port" --strictPort
    ) >"$vite_log" 2>&1 &
    vite_pid=$!
fi

application_ready=0
for ((attempt = 0; attempt < 200; attempt++)); do
    if ! kill -0 "$gateway_pid" 2>/dev/null; then
        printf 'Application gateway exited during startup.\n' >&2
        sed -n '1,120p' "$gateway_log" >&2
        exit 1
    fi
    if ((reload == 1)) && ! kill -0 "$vite_pid" 2>/dev/null; then
        printf 'Vite development server exited during startup.\n' >&2
        sed -n '1,120p' "$vite_log" >&2
        exit 1
    fi
    if curl --silent --show-error --fail --max-time 0.25 "$origin/" \
        >/dev/null 2>&1 && \
        curl --silent --show-error --fail --max-time 0.25 "$origin/healthz" \
        >/dev/null 2>&1; then
        if ((reload == 0)) ||
            curl --silent --show-error --fail --max-time 0.25 \
                "$origin/@vite/client" >/dev/null 2>&1; then
            application_ready=1
            break
        fi
    fi
    sleep 0.05
done
if ((application_ready == 0)); then
    printf 'Timed out waiting for the hosted web application.\n' >&2
    sed -n '1,120p' "$gateway_log" >&2
    if ((reload == 1)); then sed -n '1,120p' "$vite_log" >&2; fi
    exit 1
fi

web_url="$origin/"
launcher_started=1

printf '\nRSTorrent live web UI is ready.\n'
printf 'URL: %s\n' "$web_url"
printf 'Data: %s\n' "$data_root"
if ((reload == 1)); then
    printf 'Hot reload: React and CSS source changes update this page.\n'
fi
printf 'Press Ctrl+C to stop the hosted application.\n\n'

if ((open_browser == 1)); then
    if [[ "$(uname -s)" == "Darwin" ]] && command -v open >/dev/null 2>&1; then
        if ! open "$web_url"; then
            printf 'Could not open the browser; open the URL above manually.\n' >&2
        fi
    elif command -v xdg-open >/dev/null 2>&1; then
        if ! xdg-open "$web_url" >/dev/null 2>&1; then
            printf 'Could not open the browser; open the URL above manually.\n' >&2
        fi
    else
        printf 'No browser opener was found; open the URL above manually.\n' >&2
    fi
fi

while true; do
    if ! kill -0 "$gateway_pid" 2>/dev/null; then
        wait "$gateway_pid" || gateway_status=$?
        printf 'Application gateway exited unexpectedly with status %s.\n' \
            "${gateway_status:-0}" >&2
        sed -n '1,120p' "$gateway_log" >&2
        exit 1
    fi
    if ((reload == 1)) && ! kill -0 "$vite_pid" 2>/dev/null; then
        wait "$vite_pid" || vite_status=$?
        printf 'Vite development server exited unexpectedly with status %s.\n' \
            "${vite_status:-0}" >&2
        sed -n '1,120p' "$vite_log" >&2
        exit 1
    fi
    sleep 1
done
