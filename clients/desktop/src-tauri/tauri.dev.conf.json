{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSTorrent Preview",
  "version": "0.3.0",
  "identifier": "com.jstorrent.rstorrent",
  "build": {
    "beforeDevCommand": "npm --prefix ../web run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm --prefix ../web run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "JSTorrent",
        "label": "main",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://link.jstorrent.com; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
