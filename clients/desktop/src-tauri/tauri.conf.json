{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSTorrent Preview",
  "version": "0.3.1",
  "identifier": "com.jstorrent.rstorrent",
  "build": {
    "beforeBuildCommand": "npm --prefix ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "JSTorrent",
        "label": "main",
        "create": false,
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "com.jstorrent.rstorrent.torrent",
        "mimeType": "application/x-bittorrent",
        "exportedType": {
          "identifier": "com.jstorrent.rstorrent.torrent",
          "conformsTo": ["public.data"]
        },
        "description": "BitTorrent metainfo file"
      }
    ],
    "category": "Utility",
    "shortDescription": "First-party BitTorrent client powered by Rust",
    "longDescription": "JSTorrent Preview is an experimental BitTorrent client with an in-process Rust engine.",
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/rstorrent.desktop"
      },
      "rpm": {
        "desktopTemplate": "./linux/rstorrent.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["magnet"]
      }
    },
    "updater": {
      "endpoints": [
        "https://updates.graehlarts.com/rstorrent/tauri/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4OEE3ODUxMzEzNjcwOTYKUldTV2NEWXhVWGlLZUpKK0trSG5XZ09qQ1ZPVFo2ZGV0MC9Cc001UWlGSCtvaE1iNDY0RmNRZkwK"
    }
  }
}
