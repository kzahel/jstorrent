{
  "manifest_version": 3,
  "name": "JSTorrent",
  "version": "0.4.0",
  "description": "Add and manage torrents with JSTorrent on desktop and Chromebook.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "optional_host_permissions": [
    "http://100.115.92.2/*",
    "http://jstorrent.localhost/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "JSTorrent",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "32": "icons/icon-32.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://100.115.92.2:3030 http://100.115.92.2:3031 http://100.115.92.2:3032 http://100.115.92.2:3033 http://100.115.92.2:3034 ws://100.115.92.2:3030 ws://100.115.92.2:3031 ws://100.115.92.2:3032 ws://100.115.92.2:3033 ws://100.115.92.2:3034 http://100.115.92.2:7800 http://100.115.92.2:7805 http://100.115.92.2:7814 http://100.115.92.2:7827 http://100.115.92.2:7844 ws://127.0.0.1:* http://jstorrent.localhost:3030"
  },
  "externally_connectable": {
    "matches": [
      "http://jstorrent.localhost/*",
      "https://jstorrent.com/chrome-extension.html"
    ]
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
